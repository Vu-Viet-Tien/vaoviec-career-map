{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/review.js": {
      "maxDuration": 60,
      "includeFiles": "dist/workspace/{talent-acquisition-assets,employer-branding-assets}/case.js"
    },
    "api/assistant.js": {
      "maxDuration": 30,
      "includeFiles": "dist/{career-data.js,workspace/talent-acquisition-assets/case.js,workspace/employer-branding-assets/case.js}"
    }
  }
}
