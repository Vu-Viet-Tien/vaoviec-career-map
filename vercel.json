{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/review.js": {
      "maxDuration": 60,
      "includeFiles": "dist/workspace/*-assets/case.js"
    },
    "api/assistant.js": {
      "maxDuration": 30,
      "includeFiles": "dist/{career-data.js,workspace/*-assets/case.js}"
    }
  }
}
